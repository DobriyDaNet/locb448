local skyBackup = nil
local skyBrightnessSlider = 0.5

local function ApplySky()
    local Lighting = game:GetService("Lighting")
    if not skyBackup then
        skyBackup = {
            ClockTime = Lighting.ClockTime,
            Brightness = Lighting.Brightness,
            ExposureCompensation = Lighting.ExposureCompensation,
            Ambient = Lighting.Ambient,
            OutdoorAmbient = Lighting.OutdoorAmbient,
            GlobalShadows = Lighting.GlobalShadows
        }
    end
    Lighting:ClearAllChildren()

    local brightness = 0.582 + (29.11 - 0.582) * skyBrightnessSlider

    Lighting.ClockTime = 17.8
    Lighting.Brightness = brightness
    Lighting.ExposureCompensation = 0.582
    Lighting.Ambient = Color3.fromRGB(170, 120, 90)
    Lighting.OutdoorAmbient = Color3.fromRGB(255, 190, 140)
    Lighting.GlobalShadows = false
    local sky = Instance.new("Sky")
    sky.SunAngularSize = 12
    sky.MoonAngularSize = 12
    sky.StarCount = 3000
    sky.Parent = Lighting
    local atmosphere = Instance.new("Atmosphere")
    atmosphere.Density = 0.35
    atmosphere.Offset = 0.1
    atmosphere.Color = Color3.fromRGB(255, 200, 150)
    atmosphere.Decay = Color3.fromRGB(255, 170, 120)
    atmosphere.Glare = 0.4
    atmosphere.Haze = 0.6
    atmosphere.Parent = Lighting
    local color = Instance.new("ColorCorrectionEffect")
    color.Brightness = brightness * 0.05
    color.Contrast = 0.15
    color.Saturation = 0.00928
    color.TintColor = Color3.fromRGB(255, 190, 150)
    color.Parent = Lighting
    local bloom = Instance.new("BloomEffect")
    bloom.Intensity = 0.9
    bloom.Size = 40
    bloom.Threshold = 0.85
    bloom.Parent = Lighting
    local sun = Instance.new("SunRaysEffect")
    sun.Intensity = 0.112
    sun.Spread = 0.6
    sun.Parent = Lighting
end

local function UpdateSkyLive()
    local Lighting = game:GetService("Lighting")
    if not Lighting:FindFirstChildOfClass("Sky") then return end

    local brightness = 0.582 + (29.11 - 0.582) * skyBrightnessSlider
    Lighting.Brightness = brightness
    local c = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
    if c then c.Brightness = brightness * 0.05 end
end

local function RestoreSky()
    local Lighting = game:GetService("Lighting")
    Lighting:ClearAllChildren()
    if skyBackup then
        Lighting.ClockTime = skyBackup.ClockTime
        Lighting.Brightness = skyBackup.Brightness
        Lighting.ExposureCompensation = skyBackup.ExposureCompensation
        Lighting.Ambient = skyBackup.Ambient
        Lighting.OutdoorAmbient = skyBackup.OutdoorAmbient
        Lighting.GlobalShadows = skyBackup.GlobalShadows
    end
end

