local function IsPCLDDetector(object)
    if not object:IsA("BasePart") then return false end
    for _, name in ipairs({"partesp", "playercharacterlocationdetector"}) do
        if string.lower(object.Name) == string.lower(name) then return true end
    end
    return false
end

