local antiKickItem = "ToolPickaxe"

local function RemoveAntiKickPart(targetName)
    pCLDDetectors[targetName] = nil
    local data = antiKickParts[targetName]
    if data then
        if data.BP and data.BP.Parent then data.BP:Destroy() end
        if data.BG and data.BG.Parent then data.BG:Destroy() end
        if data.Plate and data.Plate.Parent then
            pcall(function() data.DestroyToy:FireServer(data.Plate) end)
        end
        antiKickParts[targetName] = nil
    end
    antiKickActive[targetName] = nil
end

local function CreateAntiKickPart(targetPlayer, targetName)
    if antiKickParts[targetName] and antiKickParts[targetName].Plate and antiKickParts[targetName].Plate.Parent then
        return
    end

    local spawnToy = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
    local destroyToy = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("DestroyToy")
    local setNetworkOwner = ReplicatedStorage:WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner")
    local grabEvents = ReplicatedStorage:WaitForChild("GrabEvents")

    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    spawnToy:InvokeServer(antiKickItem, rootPart.CFrame * CFrame.new(0, 5, 0), Vector3.zero)
    task.wait(0.3)

    local toysFolder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    local plate = nil
    if toysFolder then
        for _, child in pairs(toysFolder:GetChildren()) do
            if child.Name == antiKickItem and not child:GetAttribute("AntiKickTarget") then
                plate = child
                break
            end
        end
    end
    if not plate then return end

    plate:SetAttribute("AntiKickTarget", targetName)

    for _, part in pairs(plate:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.CanQuery = false
            part.CanTouch = false
            part.Transparency = 0.5
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
            if not part:FindFirstChild("Highlight") then
                local h = Instance.new("Highlight", part)
                h.FillColor = Color3.fromRGB(255, 105, 180)
                h.FillTransparency = 0.5
                h.OutlineColor = Color3.fromRGB(255, 20, 147)
                h.OutlineTransparency = 0
            end
        end
    end

    if plate:IsA("BasePart") and not plate:FindFirstChild("Highlight") then
        local h = Instance.new("Highlight", plate)
        h.FillColor = Color3.fromRGB(255, 105, 180)
        h.FillTransparency = 0.5
        h.OutlineColor = Color3.fromRGB(255, 20, 147)
        h.OutlineTransparency = 0
    end

    local soundPart = plate:FindFirstChild("SoundPart") or plate:FindFirstChildWhichIsA("BasePart")
    if not soundPart then
        pcall(function() destroyToy:FireServer(plate) end)
        return
    end

    pcall(function()
        if antiKickItem == "ToolPickaxe" then
            soundPart.CFrame = soundPart.CFrame * CFrame.Angles(math.rad(90), math.rad(325), math.rad(0))
        else
            soundPart.CFrame = soundPart.CFrame * CFrame.Angles(math.rad(90), 0, 0)
        end
        soundPart.AssemblyLinearVelocity = Vector3.zero
        soundPart.AssemblyAngularVelocity = Vector3.zero
    end)
    task.wait(0.05)

    local bp = Instance.new("BodyPosition")
    bp.D = 200
    bp.P = 1000
    bp.MaxForce = Vector3.new(100000, 100000, 100000)
    bp.Parent = soundPart

    local bg = Instance.new("BodyGyro")
    bg.D = 200
    bg.P = 1000
    bg.MaxTorque = Vector3.new(100000, 100000, 100000)
    bg.Parent = soundPart

    antiKickParts[targetName] = {
        Plate = plate, BP = bp, BG = bg, SoundPart = soundPart,
        DestroyToy = destroyToy, SetNetworkOwner = setNetworkOwner,
        GrabEvents = grabEvents
    }

    local lastUpdate = 0
    local lastCharacter = LocalPlayer.Character

    local connection
    connection = RunService.RenderStepped:Connect(function()
        local data = antiKickParts[targetName]
        if not data or not data.Plate or not data.Plate.Parent or not data.BP or not data.BP.Parent then
            if connection then connection:Disconnect() end
            return
        end

        local player = Players:FindFirstChild(targetName == "Self" and LocalPlayer.Name or targetName)
        if not player or not player.Parent then return end
        if not antiKickActive[targetName] then return end

        if lastCharacter ~= LocalPlayer.Character then
            lastCharacter = LocalPlayer.Character
            antiKickParts[targetName] = nil
            antiKickActive[targetName] = false
            task.wait(0.3)
            if antiKickActive[targetName] == false then
                antiKickActive[targetName] = true
                CreateAntiKickPart(player, targetName)
            end
            if connection then connection:Disconnect() end
            return
        end

        if data.Plate and data.Plate.Parent then
            for _, part in pairs(data.Plate:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                    part.CanQuery = false
                    part.CanTouch = false
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end

        local targetCharacter = player.Character
        local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
        local detector = pCLDDetectors[targetName]
        if detector and not detector.Parent then
            pCLDDetectors[targetName] = nil
            detector = nil
        end
        if not detector then
            local closestDist = math.huge
            for _, object in ipairs(Workspace:GetDescendants()) do
                if IsPCLDDetector(object) and targetRoot then
                    local dist = (object.Position - targetRoot.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        detector = object
                    end
                end
            end
            if detector then pCLDDetectors[targetName] = detector end
        end

        if detector and detector.Parent then
            local pCLD = detector
            data.BP.Position = pCLD.Position
            if data.BG and data.BG.Parent then
                if antiKickItem == "ToolPickaxe" then
                    data.BG.CFrame = pCLD.CFrame * CFrame.Angles(math.rad(90), math.rad(325), math.rad(0))
                else
                    data.BG.CFrame = pCLD.CFrame * CFrame.Angles(math.rad(90), 0, 0)
                end
            end
            if data.SoundPart and data.SoundPart.Parent then
                if antiKickItem == "ToolPickaxe" then
                    data.SoundPart.CFrame = pCLD.CFrame * CFrame.Angles(math.rad(90), math.rad(325), math.rad(0))
                else
                    data.SoundPart.CFrame = pCLD.CFrame * CFrame.Angles(math.rad(90), 0, 0)
                end
                data.SoundPart.CanCollide = false
                data.SoundPart.CanQuery = false
                data.SoundPart.CanTouch = false
                data.SoundPart.AssemblyLinearVelocity = Vector3.zero
                data.SoundPart.AssemblyAngularVelocity = Vector3.zero
            end
            if tick() - lastUpdate >= 0.1 and data.GrabEvents:FindFirstChild("CreateGrabLine") then
                lastUpdate = tick()
                pcall(function()
                    data.SetNetworkOwner:FireServer(data.SoundPart, data.SoundPart.CFrame)
                    data.GrabEvents.CreateGrabLine:FireServer(data.SoundPart, Vector3.zero, pCLD.Position, true)
                end)
            end
        else
            local targetPos = targetRoot and targetRoot.Position
            if targetPos then
                data.BP.Position = targetPos
                if data.SoundPart and data.SoundPart.Parent then
                    if antiKickItem == "ToolPickaxe" then
                        data.SoundPart.CFrame = CFrame.new(targetPos) * CFrame.Angles(math.rad(90), math.rad(325), math.rad(0))
                    else
                        data.SoundPart.CFrame = CFrame.new(targetPos) * CFrame.Angles(math.rad(90), 0, 0)
                    end
                    data.SoundPart.CanCollide = false
                    data.SoundPart.CanQuery = false
                    data.SoundPart.CanTouch = false
                    data.SoundPart.AssemblyLinearVelocity = Vector3.zero
                    data.SoundPart.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
    end)

    task.spawn(function()
        while antiKickActive[targetName] do task.wait(1) end
        if connection then connection:Disconnect() end
        pCLDDetectors[targetName] = nil
        local data = antiKickParts[targetName]
        if data then
            if data.BP and data.BP.Parent then data.BP:Destroy() end
            if data.BG and data.BG.Parent then data.BG:Destroy() end
            if data.Plate and data.Plate.Parent then
                pcall(function() data.DestroyToy:FireServer(data.Plate) end)
            end
            antiKickParts[targetName] = nil
        end
        antiKickActive[targetName] = nil
    end)
end

local function RecreateAntiKickPart(targetName)
    if antiKickActive[targetName] then
        RemoveAntiKickPart(targetName)
        task.wait(0.3)
        local player = targetName == "Self" and LocalPlayer or Players:FindFirstChild(targetName)
        if player then
            antiKickActive[targetName] = true
            CreateAntiKickPart(player, targetName)
        end
    end
end

