    part.Transparency = 1
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.Anchored = false
    part.Massless = true
    part.CFrame = detector.CFrame
    part.Parent = Workspace

    local bp = Instance.new("BodyPosition")
    bp.MaxForce = Vector3.new(100000, 100000, 100000)
    bp.D = 200
    bp.P = 1000
    bp.Position = detector.Position
    bp.Parent = part

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(100000, 100000, 100000)
    bg.D = 200
    bg.P = 1000
    bg.CFrame = detector.CFrame
    bg.Parent = part

    local box = Instance.new("BoxHandleAdornment")
    box.Adornee = part
    box.AlwaysOnTop = true
    box.ZIndex = 5
    box.Color3 = ApplyPCLDColor()
    box.Transparency = pcldTransparency
    box.Size = detector.Size
    box.Parent = game.CoreGui

    local highlight = Instance.new("Highlight")
    highlight.Adornee = part
    highlight.FillColor = ApplyPCLDColor()
    highlight.FillTransparency = pcldTransparency
    highlight.OutlineColor = Color3.fromRGB(64, 64, 64)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = part

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 160, 0, 46)
    billboard.StudsOffset = Vector3.new(0, -2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 1000
    billboard.Parent = part

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = "PCLD | " .. ownerDisplay .. "\n(" .. ownerName .. ")"
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 12
    label.TextScaled = false
    label.TextWrapped = true
    label.Parent = billboard

    local connection = RunService.RenderStepped:Connect(function()
        if not detector or not detector.Parent then return end
        if not part or not part.Parent then return end
        bp.Position = detector.Position
        bg.CFrame = detector.CFrame
    end)

    table.insert(pcldObjects, {
        Part = part, BP = bp, BG = bg,
        Box = box, Highlight = highlight,
        Billboard = billboard, Label = label,
        PCLDRef = detector, Connection = connection,
        CurrentOwnerName = ownerName, CurrentOwnerDisplay = ownerDisplay
    })
end

local function CreatePCLDTracer()
    DestroyPCLDTracer()

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head")
    if not myRoot then return end

    local bestPart = nil
    local bestDist = math.huge
    for _, data in ipairs(pcldObjects) do
        if data.Part and data.Part.Parent and data.CurrentOwnerName == LocalPlayer.Name then
            local d = (data.Part.Position - myRoot.Position).Magnitude
            if d < bestDist then
                bestDist = d
                bestPart = data.Part
            end
        end
    end
    if not bestPart then return end

    local beamPart = Instance.new("Part")
    beamPart.Name = "PCLD_TracerPart"
    beamPart.Size = Vector3.new(0.1, 0.1, 1)
    beamPart.Transparency = 1
    beamPart.Anchored = true
    beamPart.CanCollide = false
    beamPart.CanQuery = false
    beamPart.CanTouch = false
    beamPart.Parent = Workspace

    local at0 = Instance.new("Attachment", beamPart)
    at0.Name = "FromChar"
    local at1 = Instance.new("Attachment", bestPart)
    at1.Name = "ToPCLD"

    local beam = Instance.new("Beam")
    beam.Attachment0 = at0
    beam.Attachment1 = at1
    beam.Width0 = 0.065625
    beam.Width1 = 0.065625
    beam.Color = ColorSequence.new(Color3.new(1, 1, 1))
    beam.Transparency = NumberSequence.new(0, 0)
    beam.FaceCamera = true
    beam.Segments = 1
    beam.Parent = beamPart

    local connection = RunService.RenderStepped:Connect(function()
        if not beam or not beam.Parent then return end
        if not bestPart or not bestPart.Parent then
            DestroyPCLDTracer()
            return
        end
        local ch = LocalPlayer.Character
        if not ch then return end
        local root = ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Head")
        if not root then return end
        at0.WorldPosition = root.Position
        at1.WorldPosition = bestPart.Position
    end)

    pcldTracer = {
        Beam = beam, BeamPart = beamPart,
        At0 = at0, At1 = at1,
        TargetPart = bestPart, Connection = connection
    }
end

local function ClearPCLDGoodVisual()
    for _, data in ipairs(pcldObjects) do
        if data.Box and data.Box.Parent then data.Box:Destroy() end
        if data.Highlight and data.Highlight.Parent then data.Highlight:Destroy() end
        if data.Billboard and data.Billboard.Parent then data.Billboard:Destroy() end
        if data.Part and data.Part.Parent then data.Part:Destroy() end
        if data.Connection then data.Connection:Disconnect() end
    end
    pcldObjects = {}
    DestroyPCLDTracer()
end

local function CreatePCLDGoodVisual()
    ClearPCLDGoodVisual()

    local pp = {}
    for _, o in ipairs(globalPCLD) do
        if o and o.Parent and IsPCLDDetector(o) then table.insert(pp, o) end
    end

    if #pp == 0 then return end

    for _, detector in ipairs(pp) do
        local owner = GetClosestPlayerToPCLD(detector.Position)
        CreateSinglePCLD(detector, owner)
    end

    CreatePCLDTracer()

    if pcldOwnerCheckThread then task.cancel(pcldOwnerCheckThread) end
    pcldOwnerCheckThread = task.spawn(function()
        while pcldActive do
            task.wait(3)
            if not pcldActive then break end

            local needRecreateTracer = false
            for _, data in ipairs(pcldObjects) do
                if not data.PCLDRef or not data.PCLDRef.Parent then continue end
                local newOwner = GetClosestPlayerToPCLD(data.PCLDRef.Position)
                if newOwner and newOwner.Name ~= data.CurrentOwnerName then
                    data.CurrentOwnerName = newOwner.Name
                    data.CurrentOwnerDisplay = newOwner.DisplayName
                    if data.Label and data.Label.Parent then
                        data.Label.Text = "PCLD | " .. newOwner.DisplayName .. "\n(" .. newOwner.Name .. ")"
                    end
                    needRecreateTracer = true
                end
            end
            if needRecreateTracer or (pcldTracer and (not pcldTracer.TargetPart or not pcldTracer.TargetPart.Parent)) then
                CreatePCLDTracer()
            end

            local ownersWithPCLD = {}
            for _, data in ipairs(pcldObjects) do
                if data.CurrentOwnerName then
                    ownersWithPCLD[data.CurrentOwnerName] = true
                end
            end

            local missingPlayers = {}
            for _, plr in ipairs(Players:GetPlayers()) do
                if not ownersWithPCLD[plr.Name] then
                    table.insert(missingPlayers, plr)
                end
            end

            if #missingPlayers > 0 then
                local usedDetectors = {}
                for _, data in ipairs(pcldObjects) do
                    if data.PCLDRef then usedDetectors[data.PCLDRef] = true end
                end

                local freeDetectors = {}
                for _, o in ipairs(globalPCLD) do
                    if o and o.Parent and IsPCLDDetector(o) and not usedDetectors[o] then
                        table.insert(freeDetectors, o)
                    end
                end

                local added = false
                for _, plr in ipairs(missingPlayers) do
                    if #freeDetectors == 0 then break end
                    local detector = table.remove(freeDetectors, 1)
                    if detector and detector.Parent then
                        CreateSinglePCLD(detector, plr)
                        added = true
                    end
                end

                if added then
                    CreatePCLDTracer()
                end
            end
        end
    end)
end

