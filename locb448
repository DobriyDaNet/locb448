local function FastKick()
    targetGroup:AddDropdown("KickMode", {
        Text = "Kick Mode",
        Values = {"Slow", "Normal", "Fast"},
        Default = 3,
        Callback = function(value) kickMode = value end
    })

    targetGroup:AddSlider("KickDSLineDelay", {
        Text = "DS LINE",
        Min = 0, Max = 0.2, Default = 0, Rounding = 3, Suffix = " sec",
        Callback = function(value)
            kickDSLineDelay = value
            kickDsline.Normal = value
            kickDsline.Slow = value
            kickDsline.Fast = value
        end
    })

    targetGroup:AddSlider("KickHeight", {
        Text = "Kick Height (Y)",
        Min = 5, Max = 20, Default = 15, Suffix = " studs",
        Callback = function(value) kickHeight = value end
    })

    targetGroup:AddSlider("KickOffsetX", {
        Text = "Kick Offset X",
        Min = -10, Max = 10, Default = 0,
        Callback = function(value) kickOffsetX = value end
    })

    targetGroup:AddSlider("KickOffsetZ", {
        Text = "Kick Offset Z",
        Min = -10, Max = 10, Default = 0,
        Callback = function(value) kickOffsetZ = value end
    })

    targetGroup:AddToggle("Kick", {
        Text = "Kick",
        Default = false,
        Callback = function(on)
            kickEnabled = on
            if not on then return end

            task.spawn(function()
                while kickEnabled do
                    local target = targetPlayer
                    if not target or not target.Parent then task.wait() continue end

                    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local targetRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
                    local targetHumanoid = target.Character and target.Character:FindFirstChild("Humanoid")
                    if not myRoot or not targetRoot or not targetHumanoid then task.wait() continue end
                    if targetHumanoid.Health <= 0 then task.wait() continue end

                    local currentTimer = kickTimers[kickMode] or 11
                    local timerStartTime = os.clock()
                    local isKickDisplayed = false
                    local kickDisplayTime = 0
                    local pauseStartTime = 0
                    local isPaused = false

                    local grabInterval
                    local useTickInterval
                    if kickMode == "Fast" then
                        grabInterval = 0
                        useTickInterval = false
                    elseif kickMode == "Normal" then
                        grabInterval = 1 / 500
                        useTickInterval = true
                    else
                        grabInterval = 1 / 750
                        useTickInterval = true
                    end

                    local grabEvents = ReplicatedStorage:WaitForChild("GrabEvents")
                    local setNetworkOwner = grabEvents:WaitForChild("SetNetworkOwner")
                    local destroyGrabLine = grabEvents:FindFirstChild("DestroyGrabLine")
                    local createGrabLine = grabEvents:FindFirstChild("CreateGrabLine")
                    local alignPositions = {}
                    local alignOrientations = {}

                    local alignCount
                    if kickMode == "Slow" then
                        alignCount = 25
                    else
                        alignCount = 15
                    end
                    local deleteThread = nil

                    pcall(function()
                        targetHumanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
                        targetHumanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
                        targetHumanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
                    end)
                    targetHumanoid.Sit = false
                    targetHumanoid.PlatformStand = true
                    targetHumanoid.AutoRotate = false
                    targetHumanoid.WalkSpeed = 0
                    targetHumanoid.JumpPower = 0

                    local targetBP = Instance.new("BodyPosition")
                    targetBP.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                    targetBP.D = 500
                    targetBP.P = 50000
                    targetBP.Position = targetRoot.Position
                    targetBP.Parent = targetRoot

                    local targetBG = Instance.new("BodyGyro")
                    targetBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
                    targetBG.D = 500
                    targetBG.P = 50000
                    targetBG.CFrame = CFrame.new(targetRoot.Position) * CFrame.Angles(0, 0, 0)
                    targetBG.Parent = targetRoot

                    local highlight = Instance.new("Highlight")
                    highlight.Name = "KickHighlight"
                    highlight.FillColor = kickESPColor
                    highlight.FillTransparency = 0.5
                    highlight.OutlineColor = kickESPColor
                    highlight.OutlineTransparency = 0
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Adornee = target.Character
                    highlight.Parent = target.Character

                    if destroyGrabLine then
                        deleteThread = task.spawn(function()
                            while kickEnabled and target and target.Parent do
                                local targetChar = target.Character
                                local targetRoot2 = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                                if not targetRoot2 then task.wait() continue end
                                pcall(function() destroyGrabLine:FireServer(targetRoot2) end)
                                if kickDSLineDelay > 0 then task.wait(kickDSLineDelay) else task.wait() end
                            end
                        end)
                    end

                    local grabThread = task.spawn(function()
                        while kickEnabled and target and target.Parent do
                            local targetChar2 = target.Character
                            local targetRoot3 = targetChar2 and targetChar2:FindFirstChild("HumanoidRootPart")
                            local targetHum3 = targetChar2 and targetChar2:FindFirstChild("Humanoid")
                            local myChar2 = LocalPlayer.Character
                            local myRoot2 = myChar2 and myChar2:FindFirstChild("HumanoidRootPart")

                            if targetRoot3 and targetHum3 and targetHum3.Health > 0 and myRoot2 then
                                local tPos = myRoot2.Position + Vector3.new(kickOffsetX, math.min(kickHeight, 20), kickOffsetZ)
                                for _, part in pairs(targetChar2:GetChildren()) do
                                    if part:IsA("BasePart") then
                                        pcall(function() setNetworkOwner:FireServer(part, part.CFrame) end)
                                    end
                                end
                                pcall(function() setNetworkOwner:FireServer(targetRoot3, myRoot2.CFrame) end)
                                if createGrabLine then
                                    pcall(function() createGrabLine:FireServer(targetRoot3, Vector3.zero, tPos, false) end)
                                end
                            end

                            if useTickInterval then
                                task.wait(grabInterval)
                            else
                                task.wait()
                            end
                        end
                    end)

                    while kickEnabled and target and target.Parent do
                        local targetChar = target.Character
                        local targetRoot2 = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                        local targetHumanoid2 = targetChar and targetChar:FindFirstChild("Humanoid")
                        if not targetRoot2 or not targetHumanoid2 or targetHumanoid2.Health <= 0 then break end

                        myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if not myRoot then break end

                        local distance = (myRoot.Position - targetRoot2.Position).Magnitude
                        if distance > 25 then
                            myRoot.CFrame = targetRoot2.CFrame * CFrame.new(0, 0, 2)
                            myRoot.Velocity = Vector3.zero
                        end

                        local targetPosition = myRoot.Position + Vector3.new(kickOffsetX, math.min(kickHeight, 20), kickOffsetZ)

                        if targetBP and targetBP.Parent then targetBP.Position = targetPosition end
                        if targetBG and targetBG.Parent then targetBG.CFrame = CFrame.new(targetRoot2.Position) * CFrame.Angles(0, 0, 0) end

                        targetHumanoid2.Sit = false
                        targetHumanoid2.PlatformStand = true
                        targetHumanoid2.AutoRotate = false
                        targetHumanoid2.WalkSpeed = 0
                        targetHumanoid2.JumpPower = 0

                        local elapsed = os.clock() - timerStartTime
                        local remaining = currentTimer - elapsed

                        if not isPaused then
                            if remaining > 0 then
                                isKickDisplayed = false
                            else
                                if not isKickDisplayed then
                                    isKickDisplayed = true
                                    kickDisplayTime = os.clock()
                                end
                                if os.clock() - kickDisplayTime >= 3.5 then
                                    isPaused = true
                                    pauseStartTime = os.clock()
                                end
                            end
                        else
                            if os.clock() - pauseStartTime >= 2 then
                                isPaused = false
                                isKickDisplayed = false
                                timerStartTime = os.clock()
                            end
                        end

                        while #alignPositions > alignCount do
                            local a = table.remove(alignPositions)
                            if a and a.Parent then a:Destroy() end
                        end
                        while #alignOrientations > alignCount do
                            local o = table.remove(alignOrientations)
                            if o and o.Parent then o:Destroy() end
                        end

                        for i = 1, alignCount do
                            if not alignPositions[i] or not alignPositions[i].Parent then
                                if alignPositions[i] then alignPositions[i]:Destroy() end
                                local a = Instance.new("AlignPosition")
                                a.Name = "KA_" .. i
                                a.Mode = Enum.PositionAlignmentMode.OneAttachment
                                a.MaxForce = 1e13
                                a.MaxVelocity = 200000
                                a.Responsiveness = 20000
                                local at = Instance.new("Attachment", targetRoot2)
                                a.Attachment0 = at
                                a.Parent = targetRoot2
                                alignPositions[i] = a

                                local o = Instance.new("AlignOrientation")
                                o.Name = "KO_" .. i
                                o.Mode = Enum.OrientationAlignmentMode.OneAttachment
                                o.MaxTorque = 1e13
                                o.MaxAngularVelocity = 200000
                                o.Responsiveness = 20000
                                local at2 = Instance.new("Attachment", targetRoot2)
                                o.Attachment0 = at2
                                o.Parent = targetRoot2
                                alignOrientations[i] = o
                            end
                            alignPositions[i].Position = targetPosition
                            alignOrientations[i].CFrame = CFrame.new(targetRoot2.Position) * CFrame.Angles(0, 0, 0)
                        end

                        task.wait()
                    end

                    if grabThread then
                        task.cancel(grabThread)
                        grabThread = nil
                    end

                    if targetBP and targetBP.Parent then targetBP:Destroy() end
                    if targetBG and targetBG.Parent then targetBG:Destroy() end
                    if deleteThread then task.cancel(deleteThread) deleteThread = nil end
                    if highlight and highlight.Parent then highlight:Destroy() end
                    for _, a in pairs(alignPositions) do if a and a.Parent then a:Destroy() end end
                    for _, o in pairs(alignOrientations) do if o and o.Parent then o:Destroy() end end

                    local endChar = target.Character
                    if endChar then
                        local endHum = endChar:FindFirstChild("Humanoid")
                        if endHum then
                            endHum.PlatformStand = false
                            endHum.AutoRotate = true
                            endHum.WalkSpeed = 16
                            endHum.JumpPower = 50
                        end
                    end

                    task.wait()
                end
            end)
        end
    })
end

FastKick()

ThemeManager:SetLibrary(Library)
SaveManager:SetLibrary(Library)
SaveManager:IgnoreThemeSettings()
SaveManager:SetFolder("losb")
SaveManager:BuildConfigSection(settingsTab)
ThemeManager:ApplyToTab(settingsTab)
SaveManager:LoadAutoloadConfig()
