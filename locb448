        if #newPCLD > 0 then
            for i = 1, targetCount do
                local index = ((i - 1) % #newPCLD) + 1
                table.insert(expandedPCLD, newPCLD[index])
            end
        end
        globalPCLD = expandedPCLD
        task.wait(1)
    end
end)

