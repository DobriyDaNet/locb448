defenseGroup:AddToggle("BreakPCLD", {
    Text = "break PCLD (anti-kick)",
    Default = false,
    Callback = function(on)
        if breakPCLDThread then task.cancel(breakPCLDThread) breakPCLDThread = nil end
        if not on then breakPCLDCycleCount = 0 return end

        breakPCLDThread = task.spawn(function()
            local function KillPlayer()
                pcall(function()
                    local ch = LocalPlayer.Character
                    if ch then
                        local h = ch:FindFirstChild("Humanoid")
                        if h and h.Health > 0 then h.Health = 0 end
                    end
                end)
            end

            local function WaitForSpawn()
                local ch = LocalPlayer.Character
                if not ch or not ch:FindFirstChild("Humanoid") then
                    LocalPlayer.CharacterAdded:Wait()
                    task.wait(0.05)
                else
                    local h = ch:FindFirstChild("Humanoid")
                    if h and h.Health <= 0 then
                        LocalPlayer.CharacterAdded:Wait()
                        task.wait(0.05)
                    end
                end
            end

            local function IsAlive()
                local ch = LocalPlayer.Character
                if not ch then return false end
                local h = ch:FindFirstChild("Humanoid")
                if not h then return false end
                return h.Health > 0
            end

            pcall(function()
                BetterOrion:MakeNotification({
                    Name = "break PCLD (anti-kick)",
                    Content = "break PCLD (anti-kick) in process",
                    Image = "activity",
                    Time = 3,
                    Color = Color3.fromRGB(45, 45, 45),
                    TextColor = Color3.fromRGB(255, 255, 255)
                })
            end)

            while true do
                breakPCLDCycleCount = breakPCLDCycleCount + 1
                while not IsAlive() do task.wait(0.1) end
                KillPlayer()
                WaitForSpawn()
                if breakPCLDCycleCount == 1 then
                    task.wait(0.15)
                    KillPlayer()
                    WaitForSpawn()
                end
                task.wait(0.8)
                while IsAlive() do task.wait(0.1) end

                pcall(function()
                    BetterOrion:MakeNotification({
                        Name = "break PCLD (anti-kick)",
                        Content = "You got kill or reset. break PCLD (anti-kick) in process again",
                        Image = "activity",
                        Time = 3,
                        Color = Color3.fromRGB(45, 45, 45),
