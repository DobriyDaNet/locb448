local function CreateBlackHoleLine(position, holeObject)
    if not blackHoleLineEnabled then return end
    for _, lineData in ipairs(blackHoleLines) do
        if lineData.HoleObject == holeObject then return end
    end

    local line = Instance.new("Part")
    line.Name = "BlackHoleLine"
    line.Size = Vector3.new(0.1, 0.1, 1)
    line.Color = Color3.fromRGB(255, 255, 255)
    line.Material = Enum.Material.Neon
    line.Anchored = true
    line.CanCollide = false
    line.CanTouch = false
    line.CanQuery = false
    line.Transparency = 0.2
    line.Parent = Workspace

    local attachment = Instance.new("Attachment", line)
    local beam = Instance.new("Beam", line)
    beam.Attachment0 = attachment
    beam.Width0 = 0.3
    beam.Width1 = 0.3
    beam.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
    beam.Transparency = NumberSequence.new(0.1, 0.8)
    beam.Parent = line

    local connection = RunService.RenderStepped:Connect(function()
        if not line or not line.Parent or not blackHoleLineEnabled then
            if connection then connection:Disconnect() end
            return
        end
        local ch = LocalPlayer.Character
        if not ch then return end
        local rootPart = ch:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        local startPos = rootPart.Position
        local endPos = position
        local mid = (startPos + endPos) / 2
        local distance = (startPos - endPos).Magnitude
        line.CFrame = CFrame.new(mid, endPos)
        line.Size = Vector3.new(0.1, 0.1, distance)
    end)

    table.insert(blackHoleLines, { Line = line, Connection = connection, HoleObject = holeObject, HolePos = position })
end

local function CreateBlackHoleCopy(originalHole, playerName, displayName)
    local position
    local baseRadius = 10
    local targetRadius = baseRadius * 1.5 * 1.2
    if originalHole:IsA("BasePart") then
        position = originalHole.Position
    elseif originalHole:IsA("Model") and originalHole.PrimaryPart then
        position = originalHole.PrimaryPart.Position
    end
    if not position then return end

    local copy = Instance.new("Part")
    copy.Name = "BlackHoleCopy"
    copy.Shape = Enum.PartType.Ball
    copy.Size = Vector3.new(0.1, 0.1, 0.1)
    copy.CFrame = CFrame.new(position)
    copy.Anchored = true
    copy.CanCollide = false
    copy.CanTouch = false
    copy.CanQuery = false
    copy.Transparency = 0.5
    copy.Color = Color3.fromRGB(0, 0, 0)
    copy.Material = Enum.Material.SmoothPlastic
    copy.Parent = Workspace

    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(0, 0, 0)
    highlight.FillTransparency = 1
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = copy
    highlight.Parent = copy

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 180, 0, 36)
    billboard.StudsOffset = Vector3.new(0, targetRadius + 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = copy

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = displayName .. " (" .. playerName .. ")"
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.SourceSansBold
    label.TextSize = 17
    label.TextWrapped = true
    label.Parent = billboard

    local copyData = {
        Copy = copy, HoleObject = originalHole, Pos = position, Billboard = billboard,
        TargetRadius = targetRadius, BaseTextSize = 17
    }
    table.insert(blackHoleCopies, copyData)

    task.spawn(function()
        local startTime = os.clock()

        local growDuration = 0.83
        while true do
            local elapsed = os.clock() - startTime
            if elapsed >= growDuration then break end
            if not copy or not copy.Parent then return end
            local t = elapsed / growDuration
            local currentRadius = targetRadius * t
            copy.Size = Vector3.new(currentRadius * 2, currentRadius * 2, currentRadius * 2)
            label.TextSize = math.max(1, copyData.BaseTextSize * t)
            task.wait()
        end

        local holdStart = os.clock()
        while os.clock() - holdStart < 2 do
            if not copy or not copy.Parent then return end
            task.wait()
        end

        local fadeStart = os.clock()
        local fadeDuration = 4
        while os.clock() - fadeStart < fadeDuration do
            if not copy or not copy.Parent then return end
            local t = (os.clock() - fadeStart) / fadeDuration
            local currentRadius = targetRadius * (1 - t)
            copy.Size = Vector3.new(currentRadius * 2, currentRadius * 2, currentRadius * 2)
            label.TextSize = math.max(1, copyData.BaseTextSize * (1 - t))
            task.wait()
        end

        if copy and copy.Parent then copy:Destroy() end
        if billboard and billboard.Parent then billboard:Destroy() end
        for i, cd in ipairs(blackHoleCopies) do
            if cd == copyData then
                table.remove(blackHoleCopies, i)
                break
            end
        end
    end)
end

Workspace.ChildAdded:Connect(function(object)
    if object.Name == "BlackHoleKick" or object.Name == "BlackHoleDetected" then
        task.wait(0.05)
        local position
        if object:IsA("BasePart") then
            position = object.Position
        elseif object:IsA("Model") and object.PrimaryPart then
            position = object.PrimaryPart.Position
        end

        local function findOwner(obj)
            if not obj then return nil end
            local o = obj:FindFirstChild("PartOwner")
            if o and o:IsA("ObjectValue") and o.Value and o.Value:IsA("Player") then return o.Value end
            for _, child in ipairs(obj:GetDescendants()) do
                local o2 = child:FindFirstChild("PartOwner")
                if o2 and o2:IsA("ObjectValue") and o2.Value and o2.Value:IsA("Player") then return o2.Value end
            end
            return nil
        end

        local owner = findOwner(object)

        if not owner and position then
            local closestDist = math.huge
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local root = player.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dist = (root.Position - position).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            owner = player
                        end
                    end
                end
            end
        end

        local playerName = owner and owner.Name or "Unknown"
        local displayName = owner and owner.DisplayName or "Unknown"

        if position then
            CreateBlackHoleLine(position, object)
            CreateBlackHoleCopy(object, playerName, displayName)
        end
    end
end)

Workspace.ChildRemoved:Connect(function(object)
    if object.Name == "BlackHoleKick" or object.Name == "BlackHoleDetected" then
        for i, lineData in ipairs(blackHoleLines) do
            if lineData.HoleObject == object then
                if lineData.Line and lineData.Line.Parent then lineData.Line:Destroy() end
                if lineData.Connection then lineData.Connection:Disconnect() end
                table.remove(blackHoleLines, i)
                break
            end
        end
    end
end)

