defenseGroup:AddToggle("AntiKickAttach", {
    Text = "Anti Kick (Attach)",
    Default = false,
    Callback = function(value)
        _G.AntiKickAttachActive = value

        local function ClearAntiKickItems()
            local player = game.Players.LocalPlayer
            local inventory = Workspace:FindFirstChild(player.Name .. "SpawnedInToys")
            local destroyRemote = game.ReplicatedStorage:FindFirstChild("MenuToys")
            if destroyRemote then destroyRemote = destroyRemote:FindFirstChild("DestroyToy") end
            if inventory and destroyRemote then
                for _, item in pairs(inventory:GetChildren()) do
                    if item.Name == "AntiKick" or item.Name == "NinjaShuriken" or item.Name == "ToolPickaxe" then
                        pcall(function() destroyRemote:FireServer(item) end)
                    end
                end
            end
        end

        if value then
            task.spawn(function()
                local player = game.Players.LocalPlayer
                local replicatedStorage = game:GetService("ReplicatedStorage")
                local setNetworkOwner = replicatedStorage:WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner")
                local stickyPartEvent = replicatedStorage:WaitForChild("PlayerEvents"):WaitForChild("StickyPartEvent")
                local spawnRemote = replicatedStorage.MenuToys.SpawnToyRemoteFunction
                local canSpawnToy = player:WaitForChild("CanSpawnToy")

                local function GetRootPart()
                    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        return player.Character.HumanoidRootPart
                    else
                        local character = player.CharacterAdded:Wait()
                        return character:WaitForChild("HumanoidRootPart")
                    end
                end

                local function CheckPlot()
                    if not Workspace.PlotItems.PlayersInPlots:FindFirstChild(player.Name) then return false end
                    for _, plot in pairs(Workspace.Plots:GetChildren()) do
                        local sign = plot:FindFirstChild("PlotSign")
                        local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
                        if owners then
                            for _, owner in pairs(owners:GetChildren()) do
                                if owner.Value == player.Name then
                                    local plotItem = Workspace.PlotItems:FindFirstChild(plot.Name)
                                    if plotItem then return true, plotItem end
                                end
                            end
                        end
                    end
                    return false
                end

                local function StickItem(item)
                    if not item or not item:FindFirstChild("StickyPart") then return end
                    local rootPart = GetRootPart()
                    if not rootPart then return end

                    if item:FindFirstChild("SoundPart") then
                        local owner = item.SoundPart:FindFirstChild("PartOwner")
                        if not owner or owner.Value ~= player.Name then
                            setNetworkOwner:FireServer(item.SoundPart, item.SoundPart.CFrame)
                        end
                    end

                    local targetPart = rootPart:FindFirstChild("FirePlayerPart") or rootPart:WaitForChild("FirePlayerPart", 5)
                    local attachCFrame = CFrame.new(0, 0, antiKickSelectedItem == "ToolPickaxe" and -1.5 or 0) * CFrame.Angles(0, math.rad(90), math.rad(90))

                    if targetPart then
                        stickyPartEvent:FireServer(item.StickyPart, targetPart, attachCFrame)
                    else
                        stickyPartEvent:FireServer(item.StickyPart, rootPart, CFrame.new(0, 0, 0))
                    end

                    for _, part in pairs(item:GetChildren()) do
                        if part:IsA("BasePart") then
                            part.CanTouch = false
                            part.CanCollide = false
                            part.CanQuery = false
                            if not part:FindFirstChild("Highlight") then
                                local h = Instance.new("Highlight", part)
                                h.FillColor = antiKickESPColor
                                h.FillTransparency = 0.5
                                h.OutlineColor = antiKickESPColor
                                h.OutlineTransparency = 0
                            end
                        end
                    end
                end

                local function SpawnItem(name)
                    local startTime = tick()
                    while not canSpawnToy.Value do
                        if not _G.AntiKickAttachActive or tick() - startTime > 5 then return nil end
                        task.wait(0.1)
                    end
                    local rootPart = GetRootPart()
                    if rootPart then
                        task.spawn(function()
                            pcall(function()
                                spawnRemote:InvokeServer(name, rootPart.CFrame * CFrame.new(0, 12, 20), Vector3.new(0, 0, 0))
                            end)
                        end)
                    end
                    local hasPlot, plotItem = CheckPlot()
                    local inventory = Workspace:FindFirstChild(player.Name .. "SpawnedInToys")
                    if hasPlot and plotItem then
                        return plotItem:WaitForChild(name, 2)
                    elseif not Workspace.PlotItems.PlayersInPlots:FindFirstChild(player.Name) and inventory then
                        return inventory:WaitForChild(name, 2)
                    end
                    return nil
                end

                while _G.AntiKickAttachActive do
                    task.wait(0.005)
                    if not player.Character or not player.Character:FindFirstChild("Humanoid") or player.Character.Humanoid.Health <= 0 then continue end
                    local inventory = Workspace:FindFirstChild(player.Name .. "SpawnedInToys")
                    local item = inventory and inventory:FindFirstChild(antiKickSelectedItem)

                    if Workspace.PlotItems.PlayersInPlots:FindFirstChild(player.Name) then
                        local hasPlot, plotItem = CheckPlot()
                        if hasPlot and plotItem and Workspace.Plots:FindFirstChild(plotItem.Name) then
                            local sign = Workspace.Plots[plotItem.Name]:FindFirstChild("PlotSign")
                            if sign and sign.ThisPlotsOwners.Value.TimeRemainingNum.Value > 89 then
                                item = SpawnItem(antiKickSelectedItem)
                                if item == nil then continue end
                                item.Name = "AntiKick"
                                StickItem(item)
                            end
                        end
                    end
                    if not item then
                        if Workspace.PlotItems.PlayersInPlots:FindFirstChild(player.Name) then continue end
                        item = SpawnItem(antiKickSelectedItem)
                        if item == nil then continue end
                        item.Name = "AntiKick"
                    end
                    repeat
                        if item and item:FindFirstChild("StickyPart") and item.StickyPart.CanTouch == true then
                            StickItem(item)
                            item.Name = "AntiKick"
                        end
                        task.wait(0.3)
                    until not item or not _G.AntiKickAttachActive or not item:FindFirstChild("StickyPart") or item.StickyPart.CanTouch == false or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") or not item:FindFirstChild("StickyPart") or (player.Character.HumanoidRootPart.Position - item.StickyPart.Position).Magnitude >= 20
                    if not item or not item:FindFirstChild("StickyPart") or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") or (player.Character.HumanoidRootPart.Position - item.StickyPart.Position).Magnitude >= 20 then
                        ClearAntiKickItems()
                    end
                    pcall(function()
                        repeat
                            task.wait(0.05)
                        until not _G.AntiKickAttachActive or not player.Character or not player.Character:FindFirstChild("Humanoid") or not item or not item:FindFirstChild("StickyPart") or not item.StickyPart:FindFirstChild("StickyWeld") or not item.StickyPart.StickyWeld.Part1
                        if not item or not item:FindFirstChild("StickyPart") or (player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health <= 0) or not item["StickyPart"]:FindFirstChild("StickyWeld").Part1 then
                            ClearAntiKickItems()
                        end
                    end)
                end
            end)
        else
            _G.AntiKickAttachActive = false
            ClearAntiKickItems()
        end
    end
})

local function FreezeCharacter(character)
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    savedCFrame = rootPart.CFrame
    savedPosition = rootPart.Position
