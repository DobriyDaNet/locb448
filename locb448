local function LoadCustomAsset(url, prefix, ext)
    if type(url) ~= "string" or url == "" then return nil end
    if not (writefile and getcustomasset) then
        if url:match("^rbxassetid://") or url:match("^%d+$") then
            return "rbxassetid://" .. url:gsub("%D", "")
        end
        return url
    end

    local guid = game:GetService("HttpService"):GenerateGUID(false):gsub("%-", "")
    local fileName = "custom_" .. (prefix or "asset") .. "_" .. guid .. (ext or "")
    local ok, result = pcall(function()
        return game:HttpGet(url, true)
    end)
    if not ok or type(result) ~= "string" or result == "" then
        return nil
    end
    if not pcall(writefile, fileName, result) then
        return nil
    end
    CustomAssets.Files[fileName] = fileName
    local ok2, asset = pcall(getcustomasset, fileName)
    if not ok2 or not asset then
        return nil
    end
    task.delay(30, function()
        if CustomAssets.Files[fileName] then
            pcall(delfile, fileName)
            CustomAssets.Files[fileName] = nil
        end
    end)
    return asset
end

