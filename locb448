local function SitOnTrain()
    if gucciRunning then return end
    gucciRunning = true
    local ch = LocalPlayer.Character
    local humanoid = ch and ch:FindFirstChild("Humanoid")
    local rootPart = ch and ch:FindFirstChild("HumanoidRootPart")
    if not ch or not humanoid or not rootPart then
        gucciRunning = false
        return
    end
    local originalCFrame = ch:GetPivot()
    local train = Workspace.Map.AlwaysHereTweenedObjects and Workspace.Map.AlwaysHereTweenedObjects:FindFirstChild("Train")
    local seat = nil
    if train then
        for _, child in pairs(train:GetDescendants()) do
            if child:IsA("Seat") and child.Occupant == nil and child ~= lastSeatData.LastSeat then
                lastSeatData.LastSeat = child
                seat = child
                break
            end
        end
    end
    if not seat then
        gucciRunning = false
        return
    end
    seat:Sit(humanoid)
    task.spawn(function()
        local endTime = tick() + 0.5
        while tick() < endTime and task.wait() do
            pcall(function() ReplicatedStorage.CharacterEvents.RagdollRemote:FireServer(rootPart, 0) end)
        end
    end)
    task.wait()
    while not humanoid.SeatPart do task.wait() end
    humanoid.Sit = false
    task.wait()
    for i = 1, 3 do ch:PivotTo(originalCFrame) end
    gucciRunning = false
end

local function MonitorGucci()
    if gucciConnection then gucciConnection:Disconnect() gucciConnection = nil end
    gucciConnection = RunService.Heartbeat:Connect(function()
        if not gucciActive then return end
        local ch = LocalPlayer.Character
        if not ch then return end
        local humanoid = ch:FindFirstChild("Humanoid")
        if not humanoid then return end
        local rootPart = ch:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        local head = ch:FindFirstChild("Head")
        local isGrabbed = head and head:FindFirstChild("PartOwner")
        local isPhysics = humanoid:GetState() == Enum.HumanoidStateType.Physics
        local isFreefall = humanoid:GetState() == Enum.HumanoidStateType.Freefall
        local isDead = humanoid.Health <= 0
        if isGrabbed or isPhysics or isFreefall or isDead then
            pcall(function() ReplicatedStorage.CharacterEvents.RagdollRemote:FireServer(rootPart, 0) end)
            task.wait(0.5)
            if gucciActive then SitOnTrain() end
        end
