-- ============================================================

local BOOMBOX_NAME = "Boombox"
local boomboxEnabled = false
local boomboxThread = nil
local boomboxCurrent = nil
local boomboxLastOwner = nil

local BOOMBOX_OFFSET = CFrame.new(0, 1.0, 1.0) * CFrame.Angles(0, math.rad(180), 0)

local function RemoveBoombox()
    if boomboxCurrent and boomboxCurrent.Parent then
        pcall(function()
            ReplicatedStorage.MenuToys.DestroyToy:FireServer(boomboxCurrent)
        end)
    end
    boomboxCurrent = nil
    boomboxLastOwner = nil
end

local function SpawnBoombox()
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local spawnRemote = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
    pcall(function()
        spawnRemote:InvokeServer(BOOMBOX_NAME, myRoot.CFrame * CFrame.new(0, 5, 0), Vector3.zero)
    end)

    task.wait()

    local folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    if folder then
        for _, child in ipairs(folder:GetChildren()) do
            if child.Name == BOOMBOX_NAME then
                return child
            end
        end
    end
    return nil
end

local function GetBoomboxMainPart(boombox)
    if not boombox then return nil end
    if boombox:IsA("BasePart") then return boombox end
    local sp = boombox:FindFirstChild("SoundPart")
    if sp and sp:IsA("BasePart") then return sp end
    if boombox.PrimaryPart then return boombox.PrimaryPart end
    return boombox:FindFirstChildWhichIsA("BasePart")
end

local function GetBoomboxOwner(boombox)
    if not boombox then return nil end
    local part = boombox:FindFirstChild("SoundPart") or boombox:FindFirstChildWhichIsA("BasePart")
    if not part then return nil end
    local owner = part:FindFirstChild("PartOwner")
    if owner and owner:IsA("ObjectValue") then
        return owner.Value
    end
    return nil
end

local function WeldBoomboxToBack(boombox)
    if not boombox or not boombox.Parent then return end
    local myChar = LocalPlayer.Character
    if not myChar then return end

    local backPart = myChar:FindFirstChild("Torso") or myChar:FindFirstChild("UpperTorso")
    if not backPart then return end

    local mainPart = GetBoomboxMainPart(boombox)
    if not mainPart then return end

    for _, obj in ipairs(backPart:GetChildren()) do
        if obj.Name == "BoomboxWeld" or obj.Name == "BoomboxPartWeld" then obj:Destroy() end
    end
    for _, part in ipairs(boombox:GetDescendants()) do
        if part:IsA("BasePart") then
            for _, obj in ipairs(part:GetChildren()) do
                if obj.Name == "BoomboxWeld" or obj.Name == "BoomboxPartWeld" then
                    obj:Destroy()
                end
            end
        end
    end

    for _, part in pairs(boombox:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.CanQuery = false
            part.CanTouch = false
            part.Massless = true
            part.Anchored = false
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
            pcall(function()
                part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
            end)

            for _, child in ipairs(part:GetChildren()) do
                if child.Name ~= "BoomboxWeld" and child.Name ~= "BoomboxPartWeld" then
                    if child:IsA("BodyPosition") or child:IsA("BodyGyro")
                        or child:IsA("BodyVelocity") or child:IsA("BodyAngularVelocity")
                        or child:IsA("BodyForce") or child:IsA("BodyThrust")
                        or child:IsA("VectorForce") or child:IsA("Torque")
                        or child:IsA("LinearVelocity") or child:IsA("AngularVelocity")
                        or child:IsA("AlignPosition") or child:IsA("AlignOrientation")
                        or child:IsA("AlignConstraint")
                        or child:IsA("Weld") or child:IsA("WeldConstraint")
                        or child:IsA("Motor6D") or child:IsA("Snap")
                    then
                        child:Destroy()
                    end
                end
            end
        end
    end

    mainPart.CFrame = backPart.CFrame * BOOMBOX_OFFSET
    mainPart.AssemblyLinearVelocity = Vector3.zero
    mainPart.AssemblyAngularVelocity = Vector3.zero
    task.wait()

    if boombox:IsA("Model") then
        pcall(function() boombox:PivotTo(backPart.CFrame * BOOMBOX_OFFSET) end)
        task.wait()
    end

    for _, part in pairs(boombox:GetDescendants()) do
        if part:IsA("BasePart") then
            if part == mainPart then
                local weld = Instance.new("Weld")
                weld.Name = "BoomboxWeld"
                weld.Part0 = backPart
                weld.Part1 = mainPart
                weld.C0 = BOOMBOX_OFFSET
                weld.C1 = CFrame.new(0, 0, 0)
                weld.Parent = backPart
            else
                local weld = Instance.new("Weld")
                weld.Name = "BoomboxPartWeld"
                weld.Part0 = mainPart
                weld.Part1 = part
                weld.C0 = mainPart.CFrame:ToObjectSpace(part.CFrame)
                weld.C1 = CFrame.new(0, 0, 0)
                weld.Parent = mainPart
            end
        end
    end
end

soundGroup:AddToggle("BoomboxBack", {
    Text = "BoomBox",
    Default = false,
    Callback = function(on)
        boomboxEnabled = on

        if boomboxThread then
            task.cancel(boomboxThread)
            boomboxThread = nil
        end

        if not on then
            RemoveBoombox()
            return
        end

        boomboxThread = task.spawn(function()
            local myChar = LocalPlayer.Character
            if not myChar or not (myChar:FindFirstChild("Torso") or myChar:FindFirstChild("UpperTorso")) then
                RemoveBoombox()
                return
            end

            boomboxCurrent = SpawnBoombox()
            if not boomboxCurrent then return end
            boomboxLastOwner = GetBoomboxOwner(boomboxCurrent)

            task.wait()

            WeldBoomboxToBack(boomboxCurrent)

            while boomboxEnabled do
                task.wait(2)

                local ch = LocalPlayer.Character
                if not ch then
                    RemoveBoombox()
                    break
                end

                local torso = ch:FindFirstChild("Torso") or ch:FindFirstChild("UpperTorso")
                if not torso then
                    RemoveBoombox()
                    task.wait(1)
                    boomboxCurrent = SpawnBoombox()
                    if boomboxCurrent then
                        boomboxLastOwner = GetBoomboxOwner(boomboxCurrent)
                        task.wait()
                        WeldBoomboxToBack(boomboxCurrent)
                    end
                    continue
                end

                if not boomboxCurrent or not boomboxCurrent.Parent then
                    boomboxCurrent = SpawnBoombox()
                    if boomboxCurrent then
                        boomboxLastOwner = GetBoomboxOwner(boomboxCurrent)
                        task.wait()
                        WeldBoomboxToBack(boomboxCurrent)
                    end
                    continue
                end

                local owner = GetBoomboxOwner(boomboxCurrent)
                if owner and owner ~= LocalPlayer then
                    RemoveBoombox()
                    task.wait()
                    boomboxCurrent = SpawnBoombox()
                    if boomboxCurrent then
                        boomboxLastOwner = GetBoomboxOwner(boomboxCurrent)
                        task.wait()
                        WeldBoomboxToBack(boomboxCurrent)
                    end
                    continue
                end

                if not torso:FindFirstChild("BoomboxWeld") then
                    WeldBoomboxToBack(boomboxCurrent)
                end
            end
        end)
    end
})

