defenseGroup:AddToggle("PacketDetector", {
    Text = "Packet Lag Detector",
    Default = false,
    Callback = function(value)
        _G.PacketDetectorActive = value
        if not value then return end
        task.spawn(function()
            local extendGrabLine = ReplicatedStorage:WaitForChild("GrabEvents"):WaitForChild("ExtendGrabLine")
            local logs = {}

            local connection = extendGrabLine.OnClientEvent:Connect(function(...)
                if not _G.PacketDetectorActive then return end

                local totalChars = 0
                local firstData = ""
                local sender = "Unknown"
                local displayName = "Unknown"
                local args = {...}

                for _, arg in ipairs(args) do
                    local t = typeof(arg)
                    if t == "string" then
                        totalChars = totalChars + #arg
                        if firstData == "" then
                            firstData = string.sub(arg, 1, 20)
                        end
                    elseif t == "Instance" and arg:IsA("Player") then
                        sender = arg.Name
                        displayName = arg.DisplayName
                    elseif t == "Instance" and arg:IsA("Part") then
                        local owner = arg:FindFirstChild("PartOwner")
                        if owner and owner.Value and owner.Value:IsA("Player") then
                            sender = owner.Value.Name
                            displayName = owner.Value.DisplayName
                        end
                    end
                end

                if totalChars < 10000 then return end

                local sizeMB = totalChars / 1048576
                local sizeDisplay = string.format("%.2f MB", totalChars / 1048576)

                local scriptType = "Unknown"
                local firstChars = string.lower(firstData:sub(1, 10))
                local firstFive = string.lower(firstData:sub(1, 5))
                local firstFour = string.lower(firstData:sub(1, 4))
                local firstSix = string.upper(firstData:sub(1, 6))

                if firstSix == "FLOPPA" then
                    scriptType = "TheWorst"
                elseif firstFive == "0" or firstFive == "00000" then
                    scriptType = "Resonance"
                elseif firstFour == ":joy" or firstFour == "😄" then
                    scriptType = "RIP Hub"
                elseif firstData:sub(1, 2) == "❤️" or firstData:sub(1, 2) == "❤" then
                    scriptType = sizeMB > 1 and "Mercury" or "Unknown"
                elseif firstChars:find("locb") then
                    scriptType = "Locb"
                elseif firstChars:find("mercury") then
                    scriptType = "Mercury"
                end

                local content = "Player: " .. sender .. " (" .. displayName .. ")\nSize: " .. sizeDisplay .. "\nScript: " .. scriptType .. "\nData: " .. firstData .. "..."

                if not logs[sender] or tick() - logs[sender] > 3 then
                    logs[sender] = tick()
                    pcall(function()
                        BetterOrion:MakeNotification({
                            Name = "Packet Detected",
                            Content = content,
                            Image = "activity",
                            Time = 5,
                            Color = Color3.fromRGB(45, 45, 45),
                            TextColor = Color3.fromRGB(255, 255, 255)
                        })
                    end)
                end
            end)

            while _G.PacketDetectorActive do
                task.wait(1)
            end
            connection:Disconnect()
        end)
    end
})

