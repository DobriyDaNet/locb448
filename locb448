local function ApplyPCLDColor()
    return Color3.new(0.6 * pcldBrightness, 0.6 * pcldBrightness, 0.6 * pcldBrightness)
end

local function GetClosestPlayerToPCLD(position)
    local closestPlayer, closestDist = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        local ch = player.Character
        if ch then
            local root = ch:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = (position - root.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestPlayer = player
                end
            end
        end
    end
    return closestPlayer or LocalPlayer
end

local function DestroyPCLDTracer()
    if pcldTracer then
        if pcldTracer.Beam and pcldTracer.Beam.Parent then pcldTracer.Beam:Destroy() end
        if pcldTracer.BeamPart and pcldTracer.BeamPart.Parent then pcldTracer.BeamPart:Destroy() end
        if pcldTracer.Connection then pcldTracer.Connection:Disconnect() end
        pcldTracer = nil
    end
end

